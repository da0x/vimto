" editor.vim — General editor settings

" Line numbering
set number

" Encoding
set encoding=utf-8

" Tabs: 4-space expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab

" Scroll offset
set scrolloff=10

" Modern command-line completion popup
set wildoptions=pum

" Smooth scrolling (Vim 9.1)
set smoothscroll

" Autocompletion with ctrl+space
inoremap <c-space> <c-n>
inoremap <Nul> <c-n>
